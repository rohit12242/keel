# Keel environment — copy to .env and fill in.  `cp .env.example .env`
#
# .env is gitignored and must NEVER be committed. This file (.env.example) is
# committed with KEYS ONLY, no values — it documents the shape, not the secrets.
# See docs/configuration.md for what each variable is and where it comes from.

# Postgres connection string.
#   local: postgres://keel:keel_local_dev@localhost:5432/keel  (matches docker-compose.yml)
DATABASE_URL=

# The app's own base URL (scheme + host + port), no trailing slash.
#   local: http://localhost:3000
APP_BASE_URL=

# One of: debug | info | warn | error
LOG_LEVEL=

# Secret used to sign the session. Any long random string locally (>= 16 chars).
#   generate one:  openssl rand -hex 32
SESSION_SECRET=

# Sign-in (ADR-002). Required. Locally, use the deployed pool's values:
#   cd infra && terraform output cognito_domain        -> COGNITO_DOMAIN
#   SSM /keel/COGNITO_POOL_ID, /keel/COGNITO_CLIENT_ID, /keel/COGNITO_CLIENT_SECRET
COGNITO_DOMAIN=
COGNITO_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
